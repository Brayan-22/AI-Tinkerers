# ─────────────────────────────────────────────────────────────────────────────
#  Mercadia · todas las llaves en un solo lado
#
#      cp .env.example .env      y llena lo que tengas
#      npm run estado            te dice qué queda prendido y qué falta
#
#  Nada de esto es obligatorio: sin una llave, esa pieza se apaga sola y el
#  mercado sigue cerrando tratos. Lo que se apaga está anotado en cada bloque.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. El cerebro ────────────────────────────────────────────────────────────
# Con esto los agentes negocian en lenguaje natural y entienden el pedido
# escrito como lo escribe una persona. Sin ninguna de las dos, la negociación
# corre con cerebros deterministas: funciona, pero no es un agente.
# OpenAI se intenta primero y OpenRouter es el respaldo si el primero falla.
#   → platform.openai.com/api-keys   ·   openrouter.ai/keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=


# ── 2. Los dos canales: sin esto no hay tema ─────────────────────────────────
# Slack es donde pide el comprador. Socket mode: no necesitas URL pública, ni
# túnel, ni signing secret.
#   → api.slack.com/apps → Create New App → From an app manifest
#     pega deploy/slack-app-manifest.yml: trae scopes, eventos, Socket Mode e
#     Interactividad. Sin Interactividad los botones de autorizar no responden.
#     · Basic Information → App-Level Tokens → Generate (connections:write) → xapp-
#     · Install App → Install to Workspace → Bot User OAuth Token → xoxb-
#     · en Slack: /invite @Mercadia en el canal donde se compra
#   → npm run slack:check   valida los dos tokens antes de arrancar
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Telegram es donde está el proveedor, en su celular.
#   → habla con @BotFather en Telegram → /newbot → copia el token
#   OJO: un bot no puede escribir primero. Cada proveedor tiene que mandarle
#   /start al bot ANTES de la demo, o no le llega el mensaje.
TELEGRAM_BOT_TOKEN=


# ── 3. Descubrimiento de proveedores ─────────────────────────────────────────
# Busca en la web empresas que venden lo que pides y saca una referencia de
# precio con sus fuentes. Sin esto, solo se cotiza con el catálogo sembrado.
#   → dashboard.exa.ai
EXA_API_KEY=
MARKET_PLACE=Colombia


# ── 4. Sistema de registro (track Ambiguous AI) ──────────────────────────────
# Cada cotización queda como fila, el proveedor adjudicado en el CRM, el
# contrato a firma y la copia por correo. Fuera del camino crítico: si falla,
# la compra cierra igual.
#   → npx ambiguous auth signup --name "Mercadia" --human-email tu@correo.com
#   → después: npm run ambiguous:tools   (confirma el camino completo)
#   → rota esta llave antes de publicar el repo
AMBIGUOUS_API_KEY=
# AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp


# ── 5. Correo ────────────────────────────────────────────────────────────────
# Manda la autorización y el contrato al comprador. Sin llave, el enlace de
# autorización sale en pantalla y en el hilo, que para una demo es mejor que
# un correo que no llega.
#   → resend.com/api-keys
MAIL_API_KEY=
MAIL_FROM=mercadia@example.com


# ── 6. Cadena (opcional, fuera del video) ────────────────────────────────────
# Depósitos, retiros y el ancla del acta. Falla suave: sin gas, el hash existe
# igual y el trato no se pierde.
BASE_SEPOLIA_RPC=https://sepolia.base.org
# DEPOSITS_FROM_BLOCK=
# WALLETS_FILE=


# ── 7. Servidor ──────────────────────────────────────────────────────────────
PORT=3000
# PUBLIC_URL=http://localhost:3000     # base de los enlaces del correo
# APPROVAL_SECRET=                     # firma los enlaces de autorización
# APPROVAL_TTL_MS=600000               # 10 min; vencido = no
# CONTROL_TOKEN=                       # OBLIGATORIO si la URL es pública:
#                                      # sin esto, cualquiera que abra la página
#                                      # puede aprobar una compra que no es suya.
#                                      # La pantalla de operación entra por
#                                      # /arena?t=EL_TOKEN
# DB_PATH=./data/mercadia.db
