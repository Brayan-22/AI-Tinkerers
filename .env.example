# Mercadia · todas las llaves en un solo lado.
# Cómo sacar cada una: README, sección "Variables de entorno".
# Sin una llave, esa pieza se apaga sola y el mercado sigue cerrando tratos.
# Comprueba con: npm run estado

# ── Cerebro · sin esto la negociación es determinista ────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Canales · el comprador en Slack, el proveedor en su celular ──────────────
# Crea la app pegando deploy/slack-app-manifest.yml, y valida: npm run slack:check
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# ── Descubrimiento · proveedores reales de la web y precio de referencia ─────
EXA_API_KEY=
MARKET_PLACE=Colombia

# ── Registro · el rastro de cada compra en el workspace del agente ───────────
# El CLI la deja en .ambi/config.json y se lee de ahí: esto solo la sobreescribe.
AMBIGUOUS_API_KEY=

# ── Correo · sin dominio verificado solo sirve onboarding@resend.dev ─────────
MAIL_API_KEY=
MAIL_FROM=onboarding@resend.dev

# ── Cadena · opcional, falla suave ───────────────────────────────────────────
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_URL=
# CONTROL_TOKEN · OBLIGATORIO si la URL es pública, o cualquiera aprueba
# compras ajenas. La pantalla de operación entra por /arena?t=EL_TOKEN
CONTROL_TOKEN=
APPROVAL_SECRET=
